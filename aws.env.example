# Copy this file to `.env` next to docker-compose.yml on the Ubuntu server.
# Replace YOUR_EC2_PUBLIC_IP (or use a domain, without a trailing slash).

PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP:3000
CORS_ORIGIN=http://YOUR_EC2_PUBLIC_IP:3000
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:5000
NEXT_PUBLIC_WS_URL=http://YOUR_EC2_PUBLIC_IP:5000
DIGILOCKER_REDIRECT_URI=http://YOUR_EC2_PUBLIC_IP:5000/api/expert/kyc/digilocker/callback

# --- MySQL (Compose service `db`, not apt mysql-server) ---
MYSQL_ROOT_PASSWORD=Jatayu@123
MYSQL_DATABASE=jatayu_db
# Bind only on the instance. Do not use 0.0.0.0:3306.
MYSQL_PUBLISH_PORT=127.0.0.1:3306
# true = create/alter tables if you start with no dump. false = use docker/mysql/init/*.sql
DB_SYNC_ALTER=true
