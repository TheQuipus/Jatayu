{
  "info": {
    "name": "Jatayu Backend API",
    "description": "Complete HTTP API collection for the Jatayu backend. Run registration/login requests first so test scripts populate authentication variables automatically. OTP defaults to 123456 when providers are not configured.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "expertToken", "value": "" },
    { "key": "expertId", "value": "" },
    { "key": "seekerToken", "value": "" },
    { "key": "seekerId", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "razorpayKeyId", "value": "" },
    { "key": "razorpayWebhookEventId", "value": "evt_postman_001" },
    { "key": "razorpayWebhookSecret", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "razorpayOrderId", "value": "" },
    { "key": "razorpayPaymentId", "value": "" },
    { "key": "razorpayRefundId", "value": "" },
    { "key": "refundAmount", "value": "" },
    { "key": "razorpayPaymentSignature", "value": "" },
    { "key": "bookingStartAt", "value": "" },
    { "key": "bookingIdempotencyKey", "value": "" },
    { "key": "otp", "value": "123456" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
        { "name": "WebSocket Health", "request": { "method": "GET", "url": "{{baseUrl}}/health/ws" } }
      ]
    },
    {
      "name": "Payments - Razorpay",
      "item": [
        {
          "name": "Get Razorpay Config",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.keyId) pm.environment.set('razorpayKeyId', data.keyId);"] } }],
          "request": {
            "method": "GET",
            "description": "Public configuration for future Razorpay Checkout initialization. Only the public key ID is returned.",
            "url": "{{baseUrl}}/api/payments/razorpay/config"
          }
        },
        {
          "name": "Receive Razorpay Webhook",
          "event": [{ "listen": "prerequest", "script": { "exec": ["const secret = pm.environment.get('razorpayWebhookSecret');", "if (!secret) { throw new Error('Set razorpayWebhookSecret in the local Postman environment'); }", "const signature = CryptoJS.HmacSHA256(pm.request.body.raw, secret).toString(CryptoJS.enc.Hex);", "pm.variables.set('razorpayWebhookSignature', signature);"] } }],
          "request": {
            "method": "POST",
            "description": "Development webhook test. Set the local webhook secret; never commit a real secret into this collection.",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "{{razorpayWebhookSignature}}" },
              { "key": "X-Razorpay-Event-Id", "value": "{{razorpayWebhookEventId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"entity\": \"event\",\n  \"account_id\": \"acc_postman\",\n  \"event\": \"payment.captured\",\n  \"contains\": [\"payment\"],\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_postman_001\",\n        \"entity\": \"payment\",\n        \"amount\": 100,\n        \"currency\": \"INR\",\n        \"status\": \"captured\"\n      }\n    }\n  },\n  \"created_at\": 0\n}" },
            "url": "{{baseUrl}}/api/payments/webhooks/razorpay"
          }
        },
        {
          "name": "Receive Refund Processed Webhook",
          "event": [{ "listen": "prerequest", "script": { "exec": ["const secret = pm.environment.get('razorpayWebhookSecret');", "if (!secret) { throw new Error('Set razorpayWebhookSecret in the local Postman environment'); }", "const signature = CryptoJS.HmacSHA256(pm.request.body.raw, secret).toString(CryptoJS.enc.Hex);", "pm.variables.set('razorpayWebhookSignature', signature);"] } }],
          "request": {
            "method": "POST",
            "description": "Simulates Razorpay confirming a refund. Use real refund and payment IDs associated with the declined booking.",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "{{razorpayWebhookSignature}}" },
              { "key": "X-Razorpay-Event-Id", "value": "refund-processed-{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"entity\": \"event\",\n  \"event\": \"refund.processed\",\n  \"contains\": [\"refund\"],\n  \"payload\": {\n    \"refund\": {\n      \"entity\": {\n        \"id\": \"{{razorpayRefundId}}\",\n        \"entity\": \"refund\",\n        \"payment_id\": \"{{razorpayPaymentId}}\",\n        \"amount\": {{refundAmount}},\n        \"currency\": \"INR\",\n        \"status\": \"processed\"\n      }\n    }\n  }\n}" },
            "url": "{{baseUrl}}/api/payments/webhooks/razorpay"
          }
        }
      ]
    },
    {
      "name": "Public Experts",
      "item": [
        {
          "name": "List All Approved Experts",
          "request": {
            "method": "GET",
            "description": "Open endpoint. Returns approved experts with pagination and available category, language, price, and response-time filter metadata.",
            "url": "{{baseUrl}}/api/public/experts?page=1&limit=12"
          }
        },
        {
          "name": "Search and Filter Approved Experts",
          "request": {
            "method": "GET",
            "description": "Open endpoint filter example. Supported query parameters: search, category, language, minPrice, maxPrice, availability (15, 30, or 120), sort, page, and limit. Category, language, and availability accept comma-separated values.",
            "url": "{{baseUrl}}/api/public/experts?search=Postman&category=software&minPrice=0&maxPrice=3000&sort=price-asc&page=1&limit=12"
          }
        },
        {
          "name": "Filter Experts by Language and Availability",
          "request": {
            "method": "GET",
            "description": "Filters experts who speak English and have a stored response time of 30 minutes or less. Experts missing language or response-time metadata are not included.",
            "url": "{{baseUrl}}/api/public/experts?language=English&availability=30&page=1&limit=12"
          }
        },
        {
          "name": "Get Approved Expert Details",
          "request": {
            "method": "GET",
            "description": "Public endpoint. Use an approved expert UUID, for example an id returned by Featured Matches.",
            "url": "{{baseUrl}}/api/public/experts/{{expertId}}"
          }
        }
      ]
    },
    {
      "name": "Seeker Expert Booking",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{seekerToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Get Expert Booking Options",
          "request": {
            "method": "GET",
            "description": "Returns authoritative formats, prices, weekly availability, timezone, and occupied slots. expertId may also be the expert name slug.",
            "url": "{{baseUrl}}/api/seeker/experts/{{expertId}}/booking-options?days=28"
          }
        },
        {
          "name": "Create Booking and Razorpay Order",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["const bookingStartAt = pm.environment.get('bookingStartAt') || pm.collectionVariables.get('bookingStartAt');", "if (!bookingStartAt) {", "  throw new Error('Set bookingStartAt to an available ISO timestamp, for example 2026-08-17T03:00:00+05:30');", "}", "pm.variables.set('bookingStartAt', bookingStartAt);", "let idempotencyKey = pm.environment.get('bookingIdempotencyKey') || pm.collectionVariables.get('bookingIdempotencyKey');", "if (!idempotencyKey) {", "  idempotencyKey = `booking-${pm.variables.replaceIn('{{$guid}}')}`;", "  pm.collectionVariables.set('bookingIdempotencyKey', idempotencyKey);", "  if (pm.environment.name) pm.environment.set('bookingIdempotencyKey', idempotencyKey);", "}", "pm.variables.set('bookingIdempotencyKey', idempotencyKey);", "console.log('bookingStartAt:', bookingStartAt);", "console.log('bookingIdempotencyKey:', idempotencyKey);"] } },
            { "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.booking?.id) {", "  pm.collectionVariables.set('bookingId', data.booking.id);", "  if (pm.environment.name) pm.environment.set('bookingId', data.booking.id);", "}", "if (data.razorpayOrder?.id) {", "  pm.collectionVariables.set('razorpayOrderId', data.razorpayOrder.id);", "  if (pm.environment.name) pm.environment.set('razorpayOrderId', data.razorpayOrder.id);", "}"] } }
          ],
          "request": {
            "method": "POST",
            "description": "Amount is calculated by the backend from the approved expert's format price. scheduledStartAt must fall inside the expert's configured availability.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"expertId\": \"{{expertId}}\",\n  \"consultationType\": \"video\",\n  \"subject\": \"Career planning consultation\",\n  \"context\": \"I want guidance on the next steps in my career.\",\n  \"scheduledStartAt\": \"{{bookingStartAt}}\",\n  \"useCredits\": false,\n  \"idempotencyKey\": \"{{bookingIdempotencyKey}}\"\n}" },
            "url": "{{baseUrl}}/api/seeker/bookings/orders"
          }
        },
        {
          "name": "Verify Razorpay Payment",
          "request": {
            "method": "POST",
            "description": "Call after Razorpay Checkout succeeds, using the three values returned to the browser by Razorpay.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpayPaymentId\": \"{{razorpayPaymentId}}\",\n  \"razorpaySignature\": \"{{razorpayPaymentSignature}}\"\n}" },
            "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/verify-payment"
          }
        },
        { "name": "List My Bookings", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker/bookings" } },
        { "name": "Get My Booking", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}" } }
      ]
    },
    {
      "name": "Expert Booking Requests",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{expertToken}}", "type": "string" }] },
      "item": [
        {
          "name": "List and Filter Requests",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.requests?.[0]?.id) {", "  pm.collectionVariables.set('bookingId', data.requests[0].id);", "  if (pm.environment.name) pm.environment.set('bookingId', data.requests[0].id);", "}"] } }],
          "request": {
            "method": "GET",
            "description": "Returns only requests assigned to the authenticated expert. Change status to all, new, pending, accepted, or declined.",
            "url": "{{baseUrl}}/api/expert/requests?status=all&page=1&limit=20&sort=newest"
          }
        },
        {
          "name": "Accept Request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"accepted\"\n}" },
            "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/decision"
          }
        },
        {
          "name": "Decline Request and Refund",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "const payment = data.request?.payment;", "if (payment?.razorpayRefundId) {", "  pm.collectionVariables.set('razorpayRefundId', payment.razorpayRefundId);", "  if (pm.environment.name) pm.environment.set('razorpayRefundId', payment.razorpayRefundId);", "}", "if (payment?.razorpayPaymentId) {", "  pm.collectionVariables.set('razorpayPaymentId', payment.razorpayPaymentId);", "  if (pm.environment.name) pm.environment.set('razorpayPaymentId', payment.razorpayPaymentId);", "}", "if (payment?.refundedAmount || payment?.amount) {", "  const amount = payment.refundedAmount || payment.amount;", "  pm.collectionVariables.set('refundAmount', amount);", "  if (pm.environment.name) pm.environment.set('refundAmount', amount);", "}"] } }],
          "request": {
            "method": "PATCH",
            "description": "Declines immediately, restores credits, releases the slot, and initiates a full Razorpay refund when cash was captured.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"declined\",\n  \"reasonCode\": \"scheduling_conflict\",\n  \"reasonNotes\": \"I am unavailable at the selected time.\"\n}" },
            "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/decision"
          }
        }
      ]
    },
    {
      "name": "Expert Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.expertId) pm.collectionVariables.set('expertId', data.expertId);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Postman Expert\",\n  \"email\": \"postman.expert@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"+919999999901\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }
        },
        {
          "name": "Verify OTP",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('expertToken', data.token);", "if (data.user?.id) pm.collectionVariables.set('expertId', data.user.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"expertId\": \"{{expertId}}\",\n  \"code\": \"{{otp}}\"\n}" }, "url": "{{baseUrl}}/api/auth/verify-otp" }
        },
        { "name": "Resend OTP", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"expertId\": \"{{expertId}}\"\n}" }, "url": "{{baseUrl}}/api/auth/resend-otp" } },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('expertToken', data.token);", "if (data.user?.id) pm.collectionVariables.set('expertId', data.user.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman.expert@example.com\",\n  \"password\": \"Password@123\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        { "name": "Google Login (Development Mock)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"mock-google-token\",\n  \"email\": \"google.expert@example.com\",\n  \"fullName\": \"Google Expert\",\n  \"googleId\": \"postman-google-expert\"\n}" }, "url": "{{baseUrl}}/api/auth/google" } },
        { "name": "LinkedIn Login (Development Mock)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"authCode\": \"mock-linkedin-code\",\n  \"email\": \"linkedin.expert@example.com\",\n  \"fullName\": \"LinkedIn Expert\",\n  \"linkedinId\": \"postman-linkedin-expert\"\n}" }, "url": "{{baseUrl}}/api/auth/linkedin" } },
        { "name": "Public Config", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/config" } }
      ]
    },
    {
      "name": "Expert Profile & Onboarding",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{expertToken}}", "type": "string" }] },
      "item": [
        { "name": "Get Profile", "request": { "method": "GET", "url": "{{baseUrl}}/api/expert/me" } },
        { "name": "Update Profile", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"step\": \"preferences\",\n  \"category\": \"software\",\n  \"skills\": [\"Backend Architecture\", \"API Integrations\"],\n  \"experienceLevel\": \"senior\",\n  \"professionalTitle\": \"Backend Architect\",\n  \"tagLine\": \"Building scalable systems\",\n  \"bio\": \"Experienced backend engineering mentor.\",\n  \"focusAreas\": [\"System Design\"],\n  \"selectedFormats\": [\"video\"],\n  \"selectedLengths\": [\"60\"],\n  \"formatPrices\": { \"video\": 2500 },\n  \"timezone\": \"Asia/Kolkata\"\n}" }, "url": "{{baseUrl}}/api/expert/profile" } },
        { "name": "Submit Onboarding", "request": { "method": "POST", "url": "{{baseUrl}}/api/expert/submit" } },
        {
          "name": "Start DigiLocker KYC",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.authorizationUrl) pm.environment.set('digilockerAuthorizationUrl', data.authorizationUrl);"] } }],
          "request": { "method": "POST", "description": "Returns the consent URL. Open authorizationUrl in a browser; DigiLocker OAuth cannot be completed entirely inside Postman.", "url": "{{baseUrl}}/api/expert/kyc/digilocker/start" }
        },
        { "name": "Get DigiLocker KYC Status", "request": { "method": "GET", "url": "{{baseUrl}}/api/expert/kyc/digilocker/status" } }
      ]
    },
    {
      "name": "Seeker Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.seekerId) {", "  pm.collectionVariables.set('seekerId', data.seekerId);", "  if (pm.environment.name) pm.environment.set('seekerId', data.seekerId);", "}"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Postman Seeker\",\n  \"email\": \"postman.seeker@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"+919999999902\"\n}" }, "url": "{{baseUrl}}/api/seeker-auth/register" }
        },
        {
          "name": "Verify OTP",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) {", "  pm.collectionVariables.set('seekerToken', data.token);", "  if (pm.environment.name) pm.environment.set('seekerToken', data.token);", "}", "if (data.user?.id) {", "  pm.collectionVariables.set('seekerId', data.user.id);", "  if (pm.environment.name) pm.environment.set('seekerId', data.user.id);", "}"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"seekerId\": \"{{seekerId}}\",\n  \"code\": \"{{otp}}\"\n}" }, "url": "{{baseUrl}}/api/seeker-auth/verify-otp" }
        },
        { "name": "Resend OTP", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"seekerId\": \"{{seekerId}}\"\n}" }, "url": "{{baseUrl}}/api/seeker-auth/resend-otp" } },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) {", "  pm.collectionVariables.set('seekerToken', data.token);", "  if (pm.environment.name) pm.environment.set('seekerToken', data.token);", "}", "if (data.user?.id) {", "  pm.collectionVariables.set('seekerId', data.user.id);", "  if (pm.environment.name) pm.environment.set('seekerId', data.user.id);", "}"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman.seeker@example.com\",\n  \"password\": \"Password@123\"\n}" }, "url": "{{baseUrl}}/api/seeker-auth/login" }
        },
        { "name": "Google Login (Development Mock)", "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) { pm.collectionVariables.set('seekerToken', data.token); if (pm.environment.name) pm.environment.set('seekerToken', data.token); }", "if (data.user?.id) { pm.collectionVariables.set('seekerId', data.user.id); if (pm.environment.name) pm.environment.set('seekerId', data.user.id); }"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"mock-google-token\",\n  \"email\": \"google.seeker@example.com\",\n  \"fullName\": \"Google Seeker\",\n  \"googleId\": \"postman-google-seeker\"\n}" }, "url": "{{baseUrl}}/api/seeker-auth/google" } },
        { "name": "LinkedIn Login (Development Mock)", "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) { pm.collectionVariables.set('seekerToken', data.token); if (pm.environment.name) pm.environment.set('seekerToken', data.token); }", "if (data.user?.id) { pm.collectionVariables.set('seekerId', data.user.id); if (pm.environment.name) pm.environment.set('seekerId', data.user.id); }"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"authCode\": \"mock-linkedin-code\",\n  \"email\": \"linkedin.seeker@example.com\",\n  \"fullName\": \"LinkedIn Seeker\",\n  \"linkedinId\": \"postman-linkedin-seeker\"\n}" }, "url": "{{baseUrl}}/api/seeker-auth/linkedin" } },
        { "name": "Public Config", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker-auth/config" } }
      ]
    },
    {
      "name": "Seeker Profile, Credits & Matches",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{seekerToken}}", "type": "string" }] },
      "item": [
        { "name": "Get Profile and Credit Balance", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker/me" } },
        { "name": "Featured Matches", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker/featured-matches?limit=3" } },
        { "name": "Save Category Step", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"step\": \"needs\",\n  \"selectedCategory\": \"software\",\n  \"selectedTopics\": [\"Backend Architecture\", \"API Integrations\"]\n}" }, "url": "{{baseUrl}}/api/seeker/profile" } },
        { "name": "Save Needs Step", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"step\": \"format\",\n  \"needsText\": \"I need help designing a scalable backend API.\",\n  \"selectedNeedChips\": [\"career-guidance\"]\n}" }, "url": "{{baseUrl}}/api/seeker/profile" } },
        { "name": "Save Format Step", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"step\": \"budget\",\n  \"selectedFormats\": [\"video\"]\n}" }, "url": "{{baseUrl}}/api/seeker/profile" } },
        { "name": "Save Budget Step", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"step\": \"personalisation\",\n  \"selectedBudget\": \"standard\"\n}" }, "url": "{{baseUrl}}/api/seeker/profile" } },
        { "name": "Save Personalisation Step", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"step\": \"review\",\n  \"selectedLanguages\": [\"english\", \"hindi\"],\n  \"location\": \"Delhi\",\n  \"additionalContext\": \"Evening sessions preferred.\",\n  \"profilePhotoSrc\": \"/assets/img/manportrait.png\"\n}" }, "url": "{{baseUrl}}/api/seeker/profile" } },
        { "name": "Submit Onboarding", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/api/seeker/submit" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('adminToken', data.token);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@thequipus.com\",\n  \"password\": \"Admin@theQuipus\",\n  \"otp\": \"{{otp}}\"\n}" }, "url": "{{baseUrl}}/api/admin/auth/login" }
        },
        {
          "name": "Authenticated Admin APIs",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
          "item": [
            { "name": "Current Admin", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/auth/me" } },
            { "name": "Get Settings", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/settings" } },
            { "name": "Update Settings", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"settings\": {\n    \"GOOGLE_LOGIN_ENABLED\": true\n  }\n}" }, "url": "{{baseUrl}}/api/admin/settings" } },
            { "name": "Application Stats", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/applications/stats" } },
            {
              "name": "List Applications",
              "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "pm.test('Returns a paginated applications response', () => {", "  pm.expect(data).to.have.property('items').that.is.an('array');", "  pm.expect(data).to.have.property('pagination').that.is.an('object');", "});", "if (data.items?.[0]?.id) pm.environment.set('applicationId', data.items[0].id);"] } }],
              "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/applications?status={{adminApplicationStatus}}&page={{adminApplicationsPage}}&limit={{adminApplicationsLimit}}" }
            },
            { "name": "Get Application", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/applications/{{applicationId}}" } },
            { "name": "Update Application Status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_review\",\n  \"reviewerNote\": \"Reviewed through Postman\"\n}" }, "url": "{{baseUrl}}/api/admin/applications/{{applicationId}}/status" } }
          ]
        }
      ]
    }
  ]
}
