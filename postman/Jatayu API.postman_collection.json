{
  "info": {
    "name": "Jatayu Backend API",
    "description": "Complete HTTP API collection for the Jatayu backend. Run registration/login requests first so test scripts populate authentication variables automatically. OTP defaults to 123456 when providers are not configured.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "expertToken", "value": "" },
    { "key": "expertId", "value": "" },
    { "key": "seekerToken", "value": "" },
    { "key": "seekerId", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "digilockerDocumentId", "value": "" },
    { "key": "razorpayKeyId", "value": "" },
    { "key": "razorpayWebhookEventId", "value": "evt_postman_001" },
    { "key": "razorpayWebhookSecret", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "razorpayOrderId", "value": "" },
    { "key": "razorpayPaymentId", "value": "" },
    { "key": "razorpayRefundId", "value": "" },
    { "key": "refundAmount", "value": "" },
    { "key": "razorpayPaymentSignature", "value": "" },
    { "key": "bookingStartAt", "value": "" },
    { "key": "bookingIdempotencyKey", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "otp", "value": "123456" }
  ],
  "item": [
    {
      "name": "Session Reviews",
      "item": [
        {
          "name": "Get booking review",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{seekerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/review"
          }
        },
        {
          "name": "Submit booking review",
          "request": {
            "description": "New completed-session reviews award 15 credits atomically. Response includes creditsAwarded and creditBalance. Identical retries return creditsAwarded: 0 without another ledger entry. Existing reviews are not retroactively rewarded.",
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{seekerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Clear and helpful advice.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) pm.collectionVariables.set('reviewId', pm.response.json().review.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Expert reviews",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{expertToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/expert/reviews?page=1&limit=20&filter=all&sort=recent"
          }
        },
        {
          "name": "Reply to review",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{expertToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/expert/reviews/{{reviewId}}/reply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reply\": \"Thank you for your feedback.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
        { "name": "WebSocket Health", "request": { "method": "GET", "url": "{{baseUrl}}/health/ws" } }
      ]
    },
    {
      "name": "Payments - Razorpay",
      "item": [
        {
          "name": "Get Razorpay Config",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.keyId) pm.environment.set('razorpayKeyId', data.keyId);"] } }],
          "request": {
            "method": "GET",
            "description": "Public configuration for future Razorpay Checkout initialization. Only the public key ID is returned.",
            "url": "{{baseUrl}}/api/payments/razorpay/config"
          }
        },
        {
          "name": "Receive Razorpay Webhook",
          "event": [{ "listen": "prerequest", "script": { "exec": ["const secret = pm.environment.get('razorpayWebhookSecret');", "if (!secret) { throw new Error('Set razorpayWebhookSecret in the local Postman environment'); }", "const signature = CryptoJS.HmacSHA256(pm.request.body.raw, secret).toString(CryptoJS.enc.Hex);", "pm.variables.set('razorpayWebhookSignature', signature);"] } }],
          "request": {
            "method": "POST",
            "description": "Development webhook test. Set the local webhook secret; never commit a real secret into this collection.",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "{{razorpayWebhookSignature}}" },
              { "key": "X-Razorpay-Event-Id", "value": "{{razorpayWebhookEventId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"entity\": \"event\",\n  \"account_id\": \"acc_postman\",\n  \"event\": \"payment.captured\",\n  \"contains\": [\"payment\"],\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_postman_001\",\n        \"entity\": \"payment\",\n        \"amount\": 100,\n        \"currency\": \"INR\",\n        \"status\": \"captured\"\n      }\n    }\n  },\n  \"created_at\": 0\n}" },
            "url": "{{baseUrl}}/api/payments/webhooks/razorpay"
          }
        },
        {
          "name": "Receive Refund Processed Webhook",
          "event": [{ "listen": "prerequest", "script": { "exec": ["const secret = pm.environment.get('razorpayWebhookSecret');", "if (!secret) { throw new Error('Set razorpayWebhookSecret in the local Postman environment'); }", "const signature = CryptoJS.HmacSHA256(pm.request.body.raw, secret).toString(CryptoJS.enc.Hex);", "pm.variables.set('razorpayWebhookSignature', signature);"] } }],
          "request": {
            "method": "POST",
            "description": "Simulates Razorpay confirming a refund. Use real refund and payment IDs associated with the declined booking.",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "{{razorpayWebhookSignature}}" },
              { "key": "X-Razorpay-Event-Id", "value": "refund-processed-{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"entity\": \"event\",\n  \"event\": \"refund.processed\",\n  \"contains\": [\"refund\"],\n  \"payload\": {\n    \"refund\": {\n      \"entity\": {\n        \"id\": \"{{razorpayRefundId}}\",\n        \"entity\": \"refund\",\n        \"payment_id\": \"{{razorpayPaymentId}}\",\n        \"amount\": {{refundAmount}},\n        \"currency\": \"INR\",\n        \"status\": \"processed\"\n      }\n    }\n  }\n}" },
            "url": "{{baseUrl}}/api/payments/webhooks/razorpay"
          }
        }
      ]
    },
    {
      "name": "Public Experts",
      "item": [
        {
          "name": "List All Approved Experts",
          "request": {
            "method": "GET",
            "description": "Open endpoint. Returns approved experts with pagination and available category, language, price, and response-time filter metadata.",
            "url": "{{baseUrl}}/api/public/experts?page=1&limit=12"
          }
        },
        {
          "name": "Search and Filter Approved Experts",
          "request": {
            "method": "GET",
            "description": "Open endpoint filter example. Supported query parameters: search, category, language, minPrice, maxPrice, availability (15, 30, or 120), sort, page, and limit. Category, language, and availability accept comma-separated values.",
            "url": "{{baseUrl}}/api/public/experts?search=Postman&category=software&minPrice=0&maxPrice=3000&sort=price-asc&page=1&limit=12"
          }
        },
        {
          "name": "Filter Experts by Language and Availability",
          "request": {
            "method": "GET",
            "description": "Filters experts who speak English and have a stored response time of 30 minutes or less. Experts missing language or response-time metadata are not included.",
            "url": "{{baseUrl}}/api/public/experts?language=English&availability=30&page=1&limit=12"
          }
        },
        {
          "name": "Get Approved Expert Details",
          "request": {
            "method": "GET",
            "description": "Public endpoint. Use an approved expert UUID, for example an id returned by Featured Matches.",
            "url": "{{baseUrl}}/api/public/experts/{{expertId}}"
          }
        }
      ]
    },
    {
      "name": "Seeker Expert Booking",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{seekerToken}}", "type": "string" }] },
      "item": [
        {
          "name": "Get Expert Booking Options",
          "request": {
            "method": "GET",
            "description": "Returns authoritative formats, prices, weekly availability, timezone, occupied slots, the expert-specific effective minimum lead time, advance booking window, auto-accept setting, and instant-booking setting. expertId may also be the expert name slug.",
            "url": "{{baseUrl}}/api/seeker/experts/{{expertId}}/booking-options?days=90"
          }
        },
        {
          "name": "Create Booking and Razorpay Order",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["const bookingStartAt = pm.environment.get('bookingStartAt') || pm.collectionVariables.get('bookingStartAt');", "if (!bookingStartAt) {", "  throw new Error('Set bookingStartAt to an available ISO timestamp, for example 2026-08-17T03:00:00+05:30');", "}", "pm.variables.set('bookingStartAt', bookingStartAt);", "let idempotencyKey = pm.environment.get('bookingIdempotencyKey') || pm.collectionVariables.get('bookingIdempotencyKey');", "if (!idempotencyKey) {", "  idempotencyKey = `booking-${pm.variables.replaceIn('{{$guid}}')}`;", "  pm.collectionVariables.set('bookingIdempotencyKey', idempotencyKey);", "  if (pm.environment.name) pm.environment.set('bookingIdempotencyKey', idempotencyKey);", "}", "pm.variables.set('bookingIdempotencyKey', idempotencyKey);", "console.log('bookingStartAt:', bookingStartAt);", "console.log('bookingIdempotencyKey:', idempotencyKey);"] } },
            { "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.booking?.id) {", "  pm.collectionVariables.set('bookingId', data.booking.id);", "  if (pm.environment.name) pm.environment.set('bookingId', data.booking.id);", "}", "if (data.razorpayOrder?.id) {", "  pm.collectionVariables.set('razorpayOrderId', data.razorpayOrder.id);", "  if (pm.environment.name) pm.environment.set('razorpayOrderId', data.razorpayOrder.id);", "}"] } }
          ],
          "request": {
            "method": "POST",
            "description": "Amount is calculated by the backend from the approved expert's format price. scheduledStartAt and the requested duration must fall inside the expert's configured availability.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"expertId\": \"{{expertId}}\",\n  \"consultationType\": \"video\",\n  \"subject\": \"Career planning consultation\",\n  \"context\": \"I want guidance on the next steps in my career.\",\n  \"scheduledStartAt\": \"{{bookingStartAt}}\",\n  \"durationMinutes\": 15,\n  \"useCredits\": false,\n  \"idempotencyKey\": \"{{bookingIdempotencyKey}}\"\n}" },
            "url": "{{baseUrl}}/api/seeker/bookings/orders"
          }
        },
        {
          "name": "Verify Razorpay Payment",
          "request": {
            "method": "POST",
            "description": "Call after Razorpay Checkout succeeds, using the three values returned to the browser by Razorpay.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpayPaymentId\": \"{{razorpayPaymentId}}\",\n  \"razorpaySignature\": \"{{razorpayPaymentSignature}}\"\n}" },
            "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/verify-payment"
          }
        },
        { "name": "List My Bookings", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker/bookings" } },
        { "name": "Get My Booking", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}" } },
        { "name": "Get Booking Chat History", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/messages?limit=50" } },
        { "name": "Send Booking Chat Message", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"message\": \"Hello from the seeker\",\n  \"clientMessageId\": \"{{$guid}}\"\n}" }, "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/messages" } },
        { "name": "Mark Booking Chat Read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/messages/read" } },
        { "name": "Verify Extension Payment", "request": { "method": "POST", "description": "Verifies a captured Razorpay payment for an expert-approved extension and updates the session end time.", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpayPaymentId\": \"{{razorpayPaymentId}}\",\n  \"razorpaySignature\": \"{{razorpayPaymentSignature}}\"\n}" }, "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/extension/verify-payment" } },
        { "name": "Start Live Transcription", "request": { "method": "POST", "description": "Starts Agora Speech-to-Text for a confirmed booking during its join window. Normally called automatically by the live-room UI.", "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/transcription/start" } },
        { "name": "Store Final Transcript Segment", "request": { "method": "POST", "description": "Stores one finalized Agora segment idempotently.", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"speakerUid\": \"1\",\n  \"sequence\": 1,\n  \"startMs\": 1000,\n  \"durationMs\": 2500,\n  \"language\": \"en-US\",\n  \"text\": \"This is a final seeker transcript segment.\",\n  \"confidence\": 0.97,\n  \"isFinal\": true,\n  \"providerTimestamp\": 1788515100000\n}" }, "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/transcription/segments" } },
        { "name": "Stop Live Transcription", "request": { "method": "POST", "description": "Stops the active Agora Speech-to-Text agent.", "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/transcription/stop" } },
        { "name": "Get Stored Transcript", "request": { "method": "GET", "url": "{{baseUrl}}/api/seeker/bookings/{{bookingId}}/transcript" } }
      ]
    },
    {
      "name": "Expert Booking Requests",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{expertToken}}", "type": "string" }] },
      "item": [
        {
          "name": "List and Filter Requests",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.requests?.[0]?.id) {", "  pm.collectionVariables.set('bookingId', data.requests[0].id);", "  if (pm.environment.name) pm.environment.set('bookingId', data.requests[0].id);", "}"] } }],
          "request": {
            "method": "GET",
            "description": "Returns only bookings assigned to the authenticated expert. Status supports all, new, pending, upcoming, completed, and cancelled. accepted/declined remain compatible aliases.",
            "url": "{{baseUrl}}/api/expert/requests?status=all&page=1&limit=20&sort=newest"
          }
        },
        { "name": "Get Request Details", "request": { "method": "GET", "description": "Returns the assigned booking with dynamic seeker profile, schedule, consultation type, amounts, payment status, response timing, and session access.", "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}" } },
        { "name": "List Upcoming Sessions", "request": { "method": "GET", "url": "{{baseUrl}}/api/expert/requests?status=upcoming&page=1&limit=20&sort=newest" } },
        { "name": "List Completed Session History", "request": { "method": "GET", "url": "{{baseUrl}}/api/expert/requests?status=completed&page=1&limit=20&sort=newest" } },
        { "name": "List Cancelled Session History", "request": { "method": "GET", "url": "{{baseUrl}}/api/expert/requests?status=cancelled&page=1&limit=20&sort=newest" } },
        {
          "name": "Accept Request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"accepted\"\n}" },
            "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/decision"
          }
        },
        {
          "name": "Decline Request and Refund",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "const payment = data.request?.payment;", "if (payment?.razorpayRefundId) {", "  pm.collectionVariables.set('razorpayRefundId', payment.razorpayRefundId);", "  if (pm.environment.name) pm.environment.set('razorpayRefundId', payment.razorpayRefundId);", "}", "if (payment?.razorpayPaymentId) {", "  pm.collectionVariables.set('razorpayPaymentId', payment.razorpayPaymentId);", "  if (pm.environment.name) pm.environment.set('razorpayPaymentId', payment.razorpayPaymentId);", "}", "if (payment?.refundedAmount || payment?.amount) {", "  const amount = payment.refundedAmount || payment.amount;", "  pm.collectionVariables.set('refundAmount', amount);", "  if (pm.environment.name) pm.environment.set('refundAmount', amount);", "}"] } }],
          "request": {
            "method": "PATCH",
            "description": "Declines immediately, restores credits, releases the slot, and initiates a full Razorpay refund when cash was captured.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"declined\",\n  \"reasonCode\": \"scheduling_conflict\",\n  \"reasonNotes\": \"I am unavailable at the selected time.\"\n}" },
            "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/decision"
          }
        },
        { "name": "Start Live Transcription", "request": { "method": "POST", "description": "Starts Agora Speech-to-Text for the assigned confirmed booking during its join window.", "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/transcription/start" } },
        { "name": "Store Final Transcript Segment", "request": { "method": "POST", "description": "Stores one finalized Agora segment idempotently.", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"speakerUid\": \"2\",\n  \"sequence\": 2,\n  \"startMs\": 4000,\n  \"durationMs\": 3000,\n  \"language\": \"en-US\",\n  \"text\": \"This is a final expert transcript segment.\",\n  \"confidence\": 0.96,\n  \"isFinal\": true,\n  \"providerTimestamp\": 1788515103000\n}" }, "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/transcription/segments" } },
        { "name": "Stop Live Transcription", "request": { "method": "POST", "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/transcription/stop" } },
        { "name": "Get Stored Transcript", "request": { "method": "GET", "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/transcript" } }
        ,{ "name": "Get Booking Chat History", "request": { "method": "GET", "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/messages?limit=50" } }
        ,{ "name": "Send Booking Chat Message", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"message\": \"Hello from the expert\",\n  \"clientMessageId\": \"{{$guid}}\"\n}" }, "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/messages" } }
        ,{ "name": "Mark Booking Chat Read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/expert/requests/{{bookingId}}/messages/read" } }
      ]
    },
    {
      "name": "Expert Earnings",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{expertToken}}", "type": "string" }] },
      "item": [
        { "name": "Get Earnings Dashboard", "request": { "method": "GET", "description": "Returns earnings derived from the authenticated expert's completed paid bookings and paid session extensions.", "url": "{{baseUrl}}/api/expert/earnings" } }
      ]
    },
    {
      "name": "Expert Calendar Sync",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{expertToken}}", "type": "string" }] },
      "item": [
        { "name": "List Calendar Connections", "request": { "method": "GET", "url": "{{baseUrl}}/api/expert/calendar-connections" } },
        { "name": "Connect Google Calendar", "request": { "method": "POST", "description": "Returns authorizationUrl. Open it in a browser while logged in to Google.", "url": "{{baseUrl}}/api/expert/calendar-connections/google/connect" } },
        { "name": "Sync Google Calendar Now", "request": { "method": "POST", "url": "{{baseUrl}}/api/expert/calendar-connections/google/sync" } },
        { "name": "Disconnect Google Calendar", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/expert/calendar-connections/google" } },
        { "name": "Connect Microsoft Outlook", "request": { "method": "POST", "description": "Returns authorizationUrl. Open it in a browser while logged in to Microsoft.", "url": "{{baseUrl}}/api/expert/calendar-connections/microsoft/connect" } },
        { "name": "Sync Microsoft Outlook Now", "request": { "method": "POST", "url": "{{baseUrl}}/api/expert/calendar-connections/microsoft/sync" } },
        { "name": "Disconnect Microsoft Outlook", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/expert/calendar-connections/microsoft" } }
      ]
    },
    {
      "name": "Expert Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.expertId) pm.collectionVariables.set('expertId', data.expertId);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Postman Expert\",\n  \"email\": \"postman.expert@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"+919999999901\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }
        },
        {
          "name": "Verify OTP",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('expertToken', data.token);", "if (data.user?.id) pm.collectionVariables.set('expertId', data.user.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"expertId\": \"{{expertId}}\",\n  \"code\": \"{{otp}}\"\n}" }, "url": "{{baseUrl}}/api/auth/verify-otp" }
        },
        { "name": "Resend OTP", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"expertId\": \"{{expertId}}\"\n}" }, "url": "{{baseUrl}}/api/auth/resend-otp" } },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('expertToken', data.token);", "if (data.user?.id) pm.collectionVariables.set('expertId', data.user.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman.expert@example.com\",\n  \"password\": \"Password@123\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
