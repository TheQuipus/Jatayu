PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Jatayu@123

# Module-specific databases (optional — fall back to DB_NAME when unset)
EXPERT_DB_NAME=jatayu_expert_db
SEEKER_DB_NAME=jatayu_seeker_db
ADMIN_DB_NAME=jatayu_admin_db
DB_SYNC_ALTER=false
DB_CONNECT_TIMEOUT_MS=10000
DB_KEEP_ALIVE_DELAY_MS=0
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# API documentation. Set to false to disable Swagger UI and its JSON document.
SWAGGER_ENABLED=true
# Public backend origin used by Swagger requests, e.g. https://jatayuconnect.in
API_PUBLIC_URL=http://localhost:5000
SEEKER_ONBOARDING_STEP_CREDITS=5
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
FROM_EMAIL=Jatayu <your_email@gmail.com>
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
ADMIN_EMAIL=admin@thequipus.com
ADMIN_PASSWORD=Admin@theQuipus
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
BOOKING_GST_PERCENT=18
BOOKING_PLATFORM_FEE_PAISE=0
SEEKER_CREDIT_VALUE_PAISE=100
EXPERT_REQUEST_NEW_HOURS=1
EXPERT_REQUEST_RESPONSE_HOURS=24
# DigiLocker requester credentials and environment URLs are managed only from
# Admin > Settings > Auth Credentials. Secrets are not read from this file.
FRONTEND_URL=http://localhost:3000

# Primary AI Service Configuration (Can be set in .env or via Admin Panel Settings)
# Options for AI_PROVIDER_NAME: 'OpenAI GPT-4', 'Google Gemini', 'Anthropic Claude', 'Groq'
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-5.6
# Fallback AI Service (used automatically if primary provider fails)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
